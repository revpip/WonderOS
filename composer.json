{
  "name": "wonderos/platform",
  "description": "The editorial operating system.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "WonderOS\\Core\\": "modules/core/src/",
      "WonderOS\\Knowledge\\": "modules/knowledge/src/",
      "WonderOS\\Api\\": "modules/api/src/",
      "WonderOS\\Notifications\\": "modules/notifications/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WonderOS\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
